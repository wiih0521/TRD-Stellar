\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{p}{@}\PYG{k}{echo} off
\PYG{k}{title} My futile attempt at writing a stress tester.

\PYG{k}{echo} Compiling files, please wait...
g++ \PYGZhy{}std=c++14 \PYGZhy{}o test.exe test.cpp
\PYG{k}{echo} Done compiling test generator!

g++ \PYGZhy{}std=c++14 \PYGZhy{}o brute.exe brute.cpp
\PYG{k}{echo} Done compiling bruteforce submission!

g++ \PYGZhy{}std=c++14 \PYGZhy{}o sol.exe sol.cpp
\PYG{k}{echo} Done compiling (possibly) faulty submission!

\PYG{k}{for} \PYG{k}{/l} \PYG{l+s+se}{\PYGZpc{}\PYGZpc{}}x \PYG{k}{in} \PYG{p}{(}\PYG{l+m+mi}{1}, \PYG{l+m+mi}{1}, \PYG{l+m+mi}{1000000}\PYG{p}{)} \PYG{k}{do} \PYG{p}{(}
	\PYG{k}{echo} Testcase numero: \PYG{l+s+se}{\PYGZpc{}\PYGZpc{}}x
	test \PYG{p}{\PYGZgt{}} input.inp
	sol \PYG{p}{\PYGZlt{}} input.inp \PYG{p}{\PYGZgt{}} output.out
	brute \PYG{p}{\PYGZlt{}} input.inp \PYG{p}{\PYGZgt{}} output.ans
	fc output.out output.ans \PYG{p}{\PYGZgt{}} log.txt \PYG{p}{||} \PYG{k}{call} \PYG{p}{:}\PYG{n+nl}{WA}

\PYG{p}{)}
\PYG{k}{echo} Accepted!
\PYG{k}{pause}
\PYG{k}{exit}

\PYG{p}{:}\PYG{n+nl}{WA}
\PYG{k}{echo} Wrong Answer
\PYG{k}{echo} Test case:
\PYG{k}{type} input.inp
\PYG{k}{echo} Participant answer:
\PYG{k}{type} output.out
\PYG{k}{echo} Jury answer:
\PYG{k}{type} output.ans

\PYG{k}{pause}
\PYG{k}{exit}
\end{MintedVerbatim}
